# A linked session appears next to the server as .wwebjs_auth/ and is a LIVE
# CREDENTIAL. It must never be packed into a distributed bundle.
.wwebjs_auth/
.wwebjs_cache/
.lab-token
.env

# Repo scaffolding the end user does not need
.git/
.gitignore
.mcpbignore

# Claude Code plugin wiring — shipped by the repo, not by the .mcpb
.claude-plugin/
.mcp.json

# A built bundle never goes inside the next one. The file is named per build
# (--name), so a renamed build would otherwise pack the previous one.
*.mcpb
